OLLAMA_MODEL = "qwen3:8b"  # On-device reasoning model served by Ollama (pull it first: `ollama pull qwen3:8b`)
OLLAMA_BASE_URL = "http://localhost:11434"  # Ollama daemon; use "http://host.docker.internal:11434" when the app runs in Docker
SESSION_SECRET_KEY = "YOUR_SESSION_SECRET_KEY"  # Can be any random string
DEVELOPMENT_ENV = "docker"  # Set to "docker" for Docker environment, "local" for local development
IMAGES_DIR = "YOUR_IMAGES_DIR"  # Directory path for storing captured images and OCR data
FAISS_VECTOR_STORE_DIR  = "YOUR_FAISS_VECTOR_STORE_DIR"
TEXT_FILE_LIMIT = "5"  # Number of encrypted text files to trigger vector embedding generation

